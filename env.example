# JunoXMusic PRO API
API_NAME=JunoXMusic KuGou PRO API
API_VERSION=2.0.0

# Set a long random secret. If empty, API routes are public.
API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Heroku provides PORT automatically. Do not hard-code it in Heroku.
PORT=3000
HOST=0.0.0.0

# Optional KuGou/device configuration
platform=
KUGOU_API_PROXY=
KUGOU_API_GUID=
KUGOU_API_DEV=
KUGOU_API_MAC=
KUGOU_API_WEBGL=

# Optional CORS origin (use * for public clients)
CORS_ALLOW_ORIGIN=*
